{
  "compilerOptions": {
    // File Layout
    "rootDir": "./",
    "outDir": "./dist",

    // Environment
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    // JavaScript + TypeScript
    "allowJs": true,
    "checkJs": false,

    // Module
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,

    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    // Build
    "sourceMap": true,
    "noEmitOnError": true,
    "declaration": false
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
